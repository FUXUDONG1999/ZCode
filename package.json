{
    "name": "zcode",
    "version": "3.16.2",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "dev:desktop": "pnpm run dev:desktop:prod",
        "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
        "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
        "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
        "dev:official-mcp": "node scripts/dev-official-mcp-server.mjs",
        "prepare": "husky && pnpm build:cua",
        "prepare:desktop-runtime": "pnpm --filter @zcode/desktop prepare:runtime-assets",
        "dep:graph": "node scripts/dependency-graph.mjs",
        "dep:refs": "node scripts/dep-refs.mjs",
        "audit:agent-remnants": "node scripts/audit-zcode-agent-remnants.mjs",
        "build": "pnpm -r build",
        "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
        "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@zcode/desktop\" build && pnpm --filter @zcode/desktop build:no-runtime-assets",
        "build:sea": "pnpm --dir apps/zcode-cli build:sea",
        "build:sea:all": "pnpm install && pnpm --dir apps/zcode-cli build:sea",
        "build:native-search": "node scripts/build-native-search-tools.mjs",
        "pack:native-search": "node scripts/package-native-search-tools.mjs",
        "ci:ensure-native-search-deps": "node scripts/ensure-native-search-deps.mjs",
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/ui packages/desktop/tsconfig.main.json packages/desktop/tsconfig.host.json && tsc -p packages/desktop/tsconfig.remote-main.json --noEmit && tsc -p packages/zcode-cua --noEmit",
        "bundle:desktop": "pnpm --filter @zcode/desktop run bundle --",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "knip": "knip",
        "count-lines": "bash scripts/count-lines.sh",
        "ci:assert-node": "node scripts/assert-node-version.mjs",
        "build:cua": "pnpm --filter @zcode/zcode-cua build",
        "doctor:macos-release": "bash scripts/doctor-macos-release-app.sh",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix --fix-suggestions",
        "bootstrap": "node scripts/bootstrap.mjs",
        "release": "release-it",
        "release:cli": "pnpm --dir apps/zcode-cli run release",
        "release:cli:dry": "pnpm --dir apps/zcode-cli run release:dry",
        "db:schema:check": "pnpm --dir apps/zcode-cli exec tsx ../../scripts/check-sqlite-schema.ts",
        "db:schema:update": "pnpm --dir apps/zcode-cli exec tsx ../../scripts/check-sqlite-schema.ts --update"
    },
    "dependencies": {
        "border-beam": "^1.0.1",
        "d3-path": "^3.1.0",
        "tailwind-scrollbar-hide": "^4.0.0"
    },
    "devDependencies": {
        "@release-it/conventional-changelog": "^10.0.6",
        "@tanstack/react-virtual": "^3.13.23",
        "@types/node": "^25.5.0",
        "@zcode/zcode-cua": "workspace:*",
        "concurrently": "^9.1.2",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "conventional-changelog-writer": "^8.4.0",
        "dotenv": "^17.4.2",
        "husky": "^9.1.7",
        "knip": "^6.0.6",
        "lint-staged": "^17.0.8",
        "oxfmt": "^0.41.0",
        "oxlint": "^1.57.0",
        "postject": "1.0.0-alpha.6",
        "release-it": "^19.2.4",
        "ts-morph": "^28.0.0",
        "tsx": "^4.19.4",
        "turbo": "^2.4.0",
        "typescript": "^6.0.2"
    },
    "peerDependencies": {
        "@tanstack/react-virtual": "^3.13.23"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.2",
    "pnpm": {
        "overrides": {
            "react": "19.2.7",
            "react-dom": "19.2.7"
        },
        "patchedDependencies": {
            "@radix-ui/react-collapsible@1.1.12": "patches/@radix-ui__react-collapsible@1.1.12.patch",
            "@arms/rum-electron@0.0.3": "patches/@arms__rum-electron@0.0.3.patch",
            "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
            "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
        }
    }
}
